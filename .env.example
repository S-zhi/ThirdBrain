# MongoDB 连接与初始化配置
# 复制为 .env 后填入实际值；.env 已被 .gitignore 忽略

# ---- 连接 ----
RAG_MONGO_URI=mongodb://127.0.0.1:27017
# Atlas 走 mongodb+srv:// 协议，例如：
# RAG_MONGO_URI=mongodb+srv://user:password@cluster0.example.net/?retryWrites=true&w=majority
RAG_MONGO_DATABASE=rag_cold_api
RAG_MONGO_RECORD_COLLECTION=lig_update_records
RAG_MONGO_STATE_COLLECTION=lig_text_states

# ---- 客户端 ----
RAG_MONGO_APP_NAME=rag-with-cold-api-documents
RAG_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
RAG_MONGO_CONNECT_TIMEOUT_MS=5000
RAG_MONGO_MAX_POOL_SIZE=50
RAG_MONGO_MIN_POOL_SIZE=1
RAG_MONGO_RETRY_READS=true
RAG_MONGO_RETRY_WRITES=true

# ---- 事务 ----
# Standalone MongoDB 不可用；只有 Replica Set / Atlas 才设为 true
RAG_MONGO_USE_TRANSACTIONS=false

# ---- 启动初始化 ----
# auto=创建缺失 collection+索引；validate=只检查，缺失时启动失败；off=不检查
RAG_MONGO_INIT_MODE=auto
